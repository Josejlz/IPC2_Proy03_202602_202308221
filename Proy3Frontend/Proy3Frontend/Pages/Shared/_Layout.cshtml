<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAT</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proy3Frontend.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="marca" asp-page="/Index">Sistema SAT</a>
        <nav>
            <a asp-page="/Index">Inicio</a>
            <a asp-page="/Enviar">Enviar mensaje</a>
            <div class="menu">
                <span>Peticiones ▾</span>
                <div class="sub">
                    <a asp-page="/Peticiones/Contribuyente">Consultar contribuyente</a>
                    <a asp-page="/Peticiones/ResumenIva">Resumen de IVA por fecha y NIT</a>
                    <a asp-page="/Peticiones/ResumenRango">Resumen por rango de fechas</a>
                    <a asp-page="/Peticiones/Grafica">Gráficas</a>
                    <a asp-page="/Peticiones/Estadisticas">Estadísticas</a>
                    <a asp-page="/Peticiones/Reporte">Reporte en PDF</a>
                </div>
            </div>
            <div class="menu">
                <span>Ayuda ▾</span>
                <div class="sub">
                    <a asp-page="/Ayuda/Estudiante">Información del estudiante</a>
                    <a asp-page="/Ayuda/Documentacion">Documentación</a>
                </div>
            </div>
            <a asp-page="/Inicializar">Inicializar</a>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
</body>
</html>