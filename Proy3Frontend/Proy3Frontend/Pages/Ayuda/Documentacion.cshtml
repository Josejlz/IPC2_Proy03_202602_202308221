@page
@model Proy3Frontend.Pages.Ayuda.DocumentacionModel
@{
	ViewData["Title"] = "Documentacion";
}

<h1>Documentacion</h1>

@if (Model.Existe)
{
	<p><a href="@DocumentacionModel.RutaPublica" target="_blank">Abrir en una nueva pestaña.</a></p>
	<iframe class="documento" src="@DocumentacionModel.RutaPublica"></iframe>
} else
{
	<p class="error">
		Aun sin documentación.
	</p>
}

