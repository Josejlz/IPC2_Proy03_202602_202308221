@page
@model Proy3Frontend.Pages.Ayuda.DocumentacionModel
@{
    ViewData["Title"] = "Documentacion";
}

<h1>Documentación</h1>

@if (Model.Existe)
{
    <p><a href="@Model.RutaPublica" target="_blank">Abrir en una nueva pestaña.</a></p>
    <iframe class="documento" src="@Model.RutaPublica"></iframe>
} 
else
{
    <p class="error">
        Aún sin documentación.
    </p>
}

